{
  "name": "install-llvm",
  "version": "1.0.0",
  "private": true,
  "description": "Downloads and installs LLVM and Clang binaries",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && ncc build src/main.ts -o dist && node scripts/write-dist-package-json.mjs",
    "generate": "node src/generate.ts",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@octokit/rest": "22.0.1",
    "@octokit/types": "18.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "jest": "30.4.2",
    "json-stable-stringify": "1.3.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
